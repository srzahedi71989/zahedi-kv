{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zahedi-kv",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "7e9e6f00-9f5a-49f3-906f-9d8377cd965c","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "8d2fb4e3484642f6ba13c29ea0866feb" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
